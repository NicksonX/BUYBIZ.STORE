# BUYBIZ environment template.
# Copy to .env.local for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
OFFICIAL_SUPPORT_EMAIL=
RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Database and auth
# ---------------------------------------------------------------------------
# Set DEMO_MODE=true only for local evaluation. It uses an in-memory PGlite
# database, local scrypt sessions and the labelled demo checkout. Never enable
# it on a public deployment.
DEMO_MODE=false
DEMO_DB_DIR=memory://
DEMO_SESSION_SECRET=

# Supabase Postgres connection string. Use the direct or session pooler URL.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after configuring the provider in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# 32 random bytes, base64 or 64 hex characters. Required to store upstream
# proxy credentials. Generate with: openssl rand -base64 32
PROXY_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Paystack
# ---------------------------------------------------------------------------
# Use sk_test_... until the business is approved for live payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test

# ---------------------------------------------------------------------------
# AI support assistant (optional until configured)
# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint. Keep the key server-side only.
AI_SUPPORT_API_KEY=
AI_SUPPORT_BASE_URL=https://api.openai.com/v1
AI_SUPPORT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Required to call /api/cron/lifecycle in production.
CRON_SECRET=

# Internal user-to-user wallet transfers are disabled pending compliance and
# legal review. The code is present but will refuse to run unless BOTH this flag
# and the database setting are explicitly enabled. Do not enable in production.
ENABLE_WALLET_TRANSFERS=false

# Local demo credentials only. Production uses Supabase Auth.
# Demo customer: demo@buybiz.test / Demo1234!
# Demo admin: admin@buybiz.test / Admin1234!
